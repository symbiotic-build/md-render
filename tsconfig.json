{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "isolatedModules": true, "verbatimModuleSyntax": true,
    "rootDir": "src", "outDir": "dist", "declaration": true, "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src"]
}
