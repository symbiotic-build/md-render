{
  "name": "md-render",
  "version": "0.1.0",
  "description": "Offline Markdown documentation renderer and temporary localhost viewer.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "md-render": "./dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "themes", "README.md"],
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:report": "vitest run --reporter=default --reporter=junit --outputFile=reports/vitest.xml",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "mdast-util-to-string": "4.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "optionalDependencies": { "mermaid": "12.2.0" }
}
